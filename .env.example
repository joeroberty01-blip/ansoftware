# Postgres connection string. Must point at a database with prisma/init.sql applied.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/afya_nyumbani_erp?schema=public"

# Random long secret used to sign session JWTs. Generate a fresh one for
# production, e.g.: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# One-time code required on the Admin signup form (first admin account).
# Rotate/remove after the first admin is created if you want to lock the form down.
ADMIN_SIGNUP_SECRET="change-me"
