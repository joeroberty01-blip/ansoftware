# Postgres connection string. Must point at a database with prisma/init.sql applied.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/afya_nyumbani_erp?schema=public"

# Random long secret used to sign session JWTs. Generate a fresh one for
# production, e.g.: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# One-time code required on the Admin signup form (first admin account).
# Rotate/remove after the first admin is created if you want to lock the form down.
ADMIN_SIGNUP_SECRET="change-me"

# Required on Vercel (or any host with an ephemeral filesystem) for staff
# photo uploads. Add the "Blob" storage integration in your Vercel project's
# Storage tab and it sets this for you. Leave unset for local dev / Docker /
# a plain Node server, where uploads fall back to local disk.
BLOB_READ_WRITE_TOKEN=""

# Shared secret used by the Afya Nyumbani client app to post bookings to
# POST /api/integrations/bookings. Generate with: openssl rand -base64 32
# The same value must be set as ERP_API_KEY on the client app's API.
# Leave unset and that endpoint is closed: it answers 503, not 401.
INTEGRATION_API_KEY=""

# Web push notifications (visit reminders on nurses' phones).
# Generate once with:  npx web-push generate-vapid-keys
# NEXT_PUBLIC_ value is baked into the build: redeploy after changing it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Optional contact for push services. Defaults to the business email.
VAPID_SUBJECT="mailto:afyanyumbanicare@gmail.com"

# Protects /api/cron/visit-reminders. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>". Generate: openssl rand -base64 32
CRON_SECRET=""
